# Copia este archivo a .env y rellena tus valores. NO lo subas a git.

# --- EvolutionAPI (el puente a WhatsApp) ---
EVOLUTION_APIKEY=pon-una-clave-secreta-larga     # la misma que usarás en EvolutionAPI
EVOLUTION_INSTANCE=curso                          # el nombre de instancia que crees
# EVOLUTION_URL lo pone el docker-compose (http://evolution-api:8080).
# Para correr el webhook en local (sin Docker), apúntalo a tu EvolutionAPI:
# EVOLUTION_URL=http://localhost:8081

# --- El modelo (el mismo .env del curso: elige UN proveedor) ---
LLM_PROVIDER=google
GOOGLE_API_KEY=tu_llave_de_gemini
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_tu_llave
