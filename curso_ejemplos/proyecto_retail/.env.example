# ==========================================================
# .env.example · Variables del asistente de compras retail
# ==========================================================
# Copia este archivo a .env y rellena los valores:
#   cp proyecto_retail/.env.example proyecto_retail/.env
#
# Cada variable indica su default. NUNCA commitees tu .env real.
# ==========================================================


# ---- MODELO DE CHAT ----
# Cambiar de proveedor se hace AQUÍ, no en el código.
#   LLM_PROVIDER=openai  → cualquier API compatible con OpenAI (Groq, Ollama, …)
#   LLM_PROVIDER=google  → Gemini (como el resto del curso). Usa GOOGLE_API_KEY.
LLM_PROVIDER=openai

# ⚠️ LOS IDs DE MODELO CADUCAN. Son una foto con fecha (verificada el
#    2026-07-21): los proveedores retiran modelos sin avisarnos. Si ves
#    "model not found" o "model_decommissioned", no es tu código — copia un ID
#    vigente de la tabla del cheat sheet (web → Recursos → Cheat sheet) o de
#    https://console.groq.com/docs/models y pégalo en la línea LLM_MODELO.
#    Ya pasó: `qwen/qwen3-32b`, el default anterior, lo apagó Groq en 2026-07.

# --- Opción A (por defecto): Groq ---
# Llave gratuita en https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_tu_llave_de_groq_aqui
LLM_MODELO=openai/gpt-oss-120b

# --- Opción B: Ollama en tu máquina (sin llave, sin cuota) ---
# El catálogo aquí es el TUYO: el ID debe salir de `ollama list`.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODELO=qwen3:8b

# --- Opción C: Gemini ---
# LLM_PROVIDER=google
# GOOGLE_API_KEY=tu_llave_de_google_ai_studio
# LLM_MODELO=gemini-3.1-flash-lite

# Temperatura. 0 = determinista (lo que quieres para evaluar y auditar).
LLM_TEMPERATURA=0.0


# ---- CATÁLOGO ----
# "demo" → el catálogo offline versionado (data/catalogo_demo.json). Cero red.
# "live" → el endpoint público real (ver data/fetch_catalogo.py).
CATALOGO_FUENTE=demo
CATALOGO_URL=https://sifrah.com/products.json?limit=250
# Cada cuántos segundos se vuelve a bajar el catálogo en modo "live" (0 = nunca).
# Solo aplica a live: el fichero de demo no cambia solo.
# ⚠️ En modo live, si la descarga falla AL ARRANCAR el servicio no arranca —
#    servir el catálogo demo como si fuera el real daría precios falsos a
#    clientes de verdad. En cambio, si falla un REFRESCO se conserva el último
#    catálogo bueno. Ver app/catalogo.py.
CATALOGO_REFRESCO_S=900
BUSQUEDA_TOP_K=3


# ---- CACHÉ SEMÁNTICO ----
# Umbral de similitud (0-1) por encima del cual dos peticiones se consideran la
# misma y se sirve desde caché. 0.92 = estricto (un HIT equivocado da la
# respuesta a una pregunta que no se hizo).
CACHE_UMBRAL_SIMILITUD=0.92

# ---- REDIS (backend opcional del caché) ----
# Sin Redis, el caché usa memoria (degradación graceful). Puerto 6381 (host).
REDIS_HOST=localhost
REDIS_PORT=6381


# ---- LANGFUSE (observabilidad, opcional) ----
# Si los dejas vacíos, el tracing se desactiva solo (la app sigue funcionando).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000


# ---- EVALUACIÓN (CI gate) ----
# % mínimo de casos fieles para aprobar un deploy. Si baja de aquí, ci_gate.py
# sale con código 1 y BLOQUEA el deploy. (Además, CERO tolerancia a un precio
# inventado: un solo caso infiel bloquea, aunque la media pase.)
EVAL_UMBRAL_APROBACION=0.9
EVAL_MUESTRA=1.0


# ---- API ----
APP_PORT=8000


# ---- OBSERVABILIDAD: nivel del log ----
# El servicio escupe JSON a stdout, una línea por evento (observability/logs.py).
# DEBUG para desarrollar, INFO en producción, WARNING si el volumen aprieta.
# Se cambia por entorno a propósito: subir la verbosidad de un servicio que está
# fallando ahora mismo no debe exigir un redeploy del código.
LOG_LEVEL=INFO


# ---- AUTENTICACIÓN ----
# Credenciales válidas separadas por comas. El cliente manda la suya en la
# cabecera `X-API-Key`. Protege /chat, /metrics y /feedback; /health queda
# SIEMPRE abierto (el orquestador no tiene credenciales).
#
#   API_KEYS=clave-de-la-web,clave-del-bot-de-whatsapp
#
# ⚠️ VACÍO = SERVICIO ABIERTO: cualquiera que descubra la URL puede consultar el
#    asistente y gastar tu cuota de Groq. Es el modo del curso (así el material
#    se ejecuta sin configurar nada) y NO es silencioso: la app lo avisa con un
#    WARNING al arrancar y lo publica en /health como "auth_activa": false.
#    En un despliegue real, rellénalo. Genera claves con: openssl rand -hex 32
#
# ⚠️ Aquí NO hay roles, a diferencia de proyecto_llmops ("clave:rol,..."): el
#    catálogo es público y todo el mundo ve lo mismo. Solo hay autenticación
#    (¿te dejo entrar?), no autorización (¿qué puedes ver?).
API_KEYS=


# ---- CORS ----
# Qué páginas pueden llamar a esta API desde un navegador, separadas por comas.
# VACÍO = no se instala CORS, y es lo correcto para la demo: el frontend lo
# sirve este mismo servicio en `/`, así que es el mismo origen y no hace falta.
# En cuanto el widget viva en la tienda y el backend en otro dominio:
#
#   CORS_ORIGINS=https://sifrah.com
#
# ⚠️ Nunca "*": los navegadores lo rechazan combinado con credenciales, y
#    además sería regalarle la API a cualquier página de internet. Sé explícito.
CORS_ORIGINS=
