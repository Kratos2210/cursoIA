# ==========================================================
# .env.example · Variables de entorno del proyecto LLMOps
# ==========================================================
# Copia este archivo a .env y rellena los valores:
#   cp proyecto_llmops/.env.example proyecto_llmops/.env
#
# ¿Qué pasa si algo falta? Cada variable indica su comportamiento por defecto.
# NUNCA commitees tu .env real: va ignorado en el .gitignore.
# ==========================================================


# ---- MODELO DE CHAT ----
# Cambiar de proveedor se hace AQUÍ, no en el código.
#
#   LLM_PROVIDER=openai  → cualquier API que hable el dialecto de OpenAI:
#                          Groq, Ollama, Together, OpenAI… Usa LLM_BASE_URL.
#   LLM_PROVIDER=google  → Gemini (como el resto del curso). Usa GOOGLE_API_KEY.
LLM_PROVIDER=openai

# --- Opción A (por defecto): Groq ---
# Llave gratuita en https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_tu_llave_de_groq_aqui
# Modelo barato de la cascada (se usa primero; el caro solo si hace falta).
LLM_MODELO_CHEAP=qwen/qwen3-32b
# Modelo de mayor razonamiento (fallback y escalado por complejidad).
# Debe ser DISTINTO al cheap: si no, la cascada reintenta con el mismo modelo.
LLM_MODELO_STRONG=llama-3.3-70b-versatile

# --- Opción B: Ollama en tu máquina (sin llave, sin cuota) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODELO_CHEAP=qwen3:8b
# LLM_MODELO_STRONG=qwen3:32b

# --- Opción C: Gemini (el proveedor del resto del curso) ---
# LLM_PROVIDER=google
# GOOGLE_API_KEY=tu_llave_de_google_ai_studio
# LLM_MODELO_CHEAP=gemini-3.1-flash-lite
# LLM_MODELO_STRONG=gemini-2.5-flash

# Temperatura del modelo. 0 = determinista (lo que quieres para evaluar y auditar).
LLM_TEMPERATURA=0.0


# ---- EMBEDDINGS (siempre en local, nunca una API) ----
# Groq no ofrece embeddings, y cambiar de modelo invalidaría el índice entero.
# Por eso se calculan en tu máquina: ni cuota, ni red, ni proveedor.
#
#   fastembed   → el modelo en ONNX, sin PyTorch (~70 MB). Lo usa la CI y es
#                 lo único que corre en macOS Intel. Por defecto.
#   huggingface → HuggingFaceEmbeddings (sentence-transformers + PyTorch).
#                 Requiere:  uv sync --extra llmops --extra hf
#                 ⚠️ No instalable en macOS Intel: torch se quedó en la 2.2.2 ahí,
#                    y esa versión choca con NumPy 2 y con transformers>=5.
#
# Ambos cargan el MISMO modelo y dan el mismo vector: cambiar de motor no
# obliga a reindexar. Cambiar de MODELO, sí.
EMBEDDINGS_PROVIDER=fastembed
# Multilingüe a propósito: la normativa está en español.
EMBEDDINGS_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2


# ---- POSTGRES + pgvector (vector store del RAG) ----
# Coincide con docker-compose.yml. El puerto 5433 en el host → 5432 en el contenedor.
PG_HOST=localhost
PG_PORT=5433
PG_USER=gobdata
PG_PASSWORD=gobdata
PG_DB=gobdata


# ---- REDIS (backend del semantic cache) ----
# Puerto 6380 en el host → 6379 en el contenedor.
REDIS_HOST=localhost
REDIS_PORT=6380
# Umbral de similitud (0.0-1.0) por encima del cual una pregunta se considera
# "la misma" que una ya respondida y se sirve desde caché. 0.92 = muy estricto.
CACHE_UMBRAL_SIMILITUD=0.92


# ---- LANGFUSE (observabilidad) ----
# Cópialos de http://localhost:3000 → Settings → API Keys (tras el primer arranque).
# Si los dejas vacíos, el tracing se desactiva solo (la app sigue funcionando).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Secretos del CONTENEDOR de Langfuse (los lee docker-compose.yml, no la app).
# ⚠️ SIN DEFAULT: `docker compose up` falla si faltan. Es deliberado — antes
#    había literales "cambia-esto-en-produccion" que, por funcionar, nadie
#    cambiaba nunca. Genera los tuyos:  openssl rand -base64 32
NEXTAUTH_SECRET=
LANGFUSE_SALT=


# ---- EVALUACIÓN (CI gate) ----
# Score mínimo (0.0-1.0) de la tríada RAG para que un deploy se apruebe.
# Si baja de aquí, ci_gate.py sale con código 1 y BLOQUEA el deploy.
EVAL_UMBRAL_APROBACION=0.7
# ¿Qué porcentaje del dataset evalúa la CI? 1.0 = todo; 0.2 = una quinta parte (más rápido).
EVAL_MUESTRA=0.2


# ---- API (FastAPI) ----
# Puerto en el que sirve la app.
APP_PORT=8000
# Nivel del rol por defecto cuando no se especifica uno en la request.
# Roles válidos: public, analyst, compliance (ver guardrails/rbac.py).
APP_ROL_POR_DEFECTO=analyst

# ---- AUTENTICACIÓN ----
# Credenciales y el rol que otorga cada una: "clave:rol,otra:rol".
# Roles válidos: public, analyst, compliance.
#
# VACÍO (lo de abajo) = SERVICIO ABIERTO: cualquiera consulta y el `rol` viaja
# en el body, que es lo que hace ejecutable el curso sin configurar nada. La app
# lo avisa al arrancar y lo publica en /health como "auth_activa": false.
#
# Para un despliegue real, descoméntalo y pon claves de verdad
# (`openssl rand -hex 32`), una por rol:
# API_KEYS=clave-del-analista:analyst,clave-de-cumplimiento:compliance
API_KEYS=

# Orígenes que pueden llamar a la API desde un navegador, separados por comas.
# Vacío = no se instala CORS (la demo sirve su frontend desde el mismo origen).
# ⚠️ No pongas "*": sería abrir la API a cualquier página de internet.
# CORS_ORIGINS=https://gobdata.pe,https://intranet.gobdata.pe
CORS_ORIGINS=

# ---- PERSISTENCIA DE MÉTRICAS ----
# "memoria" (por defecto) o "postgres".
# En memoria, cada worker cuenta lo suyo y un reinicio borra el historial: por
# eso /metrics informa de una fracción arbitraria del tráfico cuando hay varios
# workers. Con "postgres" la tabla se comparte y el resumen vuelve a hablar del
# servicio entero. Reutiliza el Postgres que el compose ya levanta para pgvector.
METRICAS_BACKEND=memoria

# ---- LÍMITE DE PETICIONES ----
# Peticiones por cliente y ventana antes de responder 429. 0 = sin límite.
# Cada /chat cuesta dinero real: esto es lo que evita que un bucle mal escrito
# te vacíe la cuenta del proveedor.
# ⚠️ Es POR PROCESO: con N workers el límite efectivo es N × este número. El
#    límite de verdad va en el reverse proxy o en Redis (ver app/rate_limit.py).
RATE_LIMIT_PETICIONES=30
RATE_LIMIT_VENTANA_S=60

# ---- RESILIENCIA DEL CLIENTE LLM ----
# Segundos antes de dar por perdida una llamada al modelo. Sin timeout, un
# proveedor que acepta la conexión y no contesta deja el worker colgado.
LLM_TIMEOUT_S=30
# Reintentos ante errores transitorios (429, 503). El cliente ya los espacia con
# backoff exponencial y respeta `Retry-After`. Se compone con la cascada
# cheap→strong, así que el peor caso es (reintentos × timeout) por cada modelo.
LLM_MAX_REINTENTOS=2

# ---- LOGGING ----
# Verbosidad del log JSON que la app escupe por stdout (ver
# observability/logs.py). DEBUG para desarrollar, INFO en producción.
# Valores: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
