# ==========================================================
# .env.example · Variables de entorno del proyecto LLMOps
# ==========================================================
# Copia este archivo a .env y rellena los valores:
#   cp proyecto_llmops/.env.example proyecto_llmops/.env
#
# ¿Qué pasa si algo falta? Cada variable indica su comportamiento por defecto.
# NUNCA commitees tu .env real: va ignorado en el .gitignore.
# ==========================================================


# ---- MODELO DE CHAT ----
# Cambiar de proveedor se hace AQUÍ, no en el código.
#
#   LLM_PROVIDER=openai  → cualquier API que hable el dialecto de OpenAI:
#                          Groq, Ollama, Together, OpenAI… Usa LLM_BASE_URL.
#   LLM_PROVIDER=google  → Gemini (como el resto del curso). Usa GOOGLE_API_KEY.
LLM_PROVIDER=openai

# --- Opción A (por defecto): Groq ---
# Llave gratuita en https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_tu_llave_de_groq_aqui
# Modelo barato de la cascada (se usa primero; el caro solo si hace falta).
LLM_MODELO_CHEAP=qwen/qwen3-32b
# Modelo de mayor razonamiento (fallback y escalado por complejidad).
# Debe ser DISTINTO al cheap: si no, la cascada reintenta con el mismo modelo.
LLM_MODELO_STRONG=llama-3.3-70b-versatile

# --- Opción B: Ollama en tu máquina (sin llave, sin cuota) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODELO_CHEAP=qwen3:8b
# LLM_MODELO_STRONG=qwen3:32b

# --- Opción C: Gemini (el proveedor del resto del curso) ---
# LLM_PROVIDER=google
# GOOGLE_API_KEY=tu_llave_de_google_ai_studio
# LLM_MODELO_CHEAP=gemini-2.0-flash
# LLM_MODELO_STRONG=gemini-2.5-flash

# Temperatura del modelo. 0 = determinista (lo que quieres para evaluar y auditar).
LLM_TEMPERATURA=0.0


# ---- EMBEDDINGS (siempre en local, nunca una API) ----
# Groq no ofrece embeddings, y cambiar de modelo invalidaría el índice entero.
# Por eso se calculan en tu máquina: ni cuota, ni red, ni proveedor.
#
#   fastembed   → el modelo en ONNX, sin PyTorch (~70 MB). Lo usa la CI y es
#                 lo único que corre en macOS Intel. Por defecto.
#   huggingface → HuggingFaceEmbeddings (sentence-transformers + PyTorch).
#                 Requiere:  uv sync --extra llmops --extra hf
#                 ⚠️ No instalable en macOS Intel: torch se quedó en la 2.2.2 ahí,
#                    y esa versión choca con NumPy 2 y con transformers>=5.
#
# Ambos cargan el MISMO modelo y dan el mismo vector: cambiar de motor no
# obliga a reindexar. Cambiar de MODELO, sí.
EMBEDDINGS_PROVIDER=fastembed
# Multilingüe a propósito: la normativa está en español.
EMBEDDINGS_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2


# ---- POSTGRES + pgvector (vector store del RAG) ----
# Coincide con docker-compose.yml. El puerto 5433 en el host → 5432 en el contenedor.
PG_HOST=localhost
PG_PORT=5433
PG_USER=gobdata
PG_PASSWORD=gobdata
PG_DB=gobdata


# ---- REDIS (backend del semantic cache) ----
# Puerto 6380 en el host → 6379 en el contenedor.
REDIS_HOST=localhost
REDIS_PORT=6380
# Umbral de similitud (0.0-1.0) por encima del cual una pregunta se considera
# "la misma" que una ya respondida y se sirve desde caché. 0.92 = muy estricto.
CACHE_UMBRAL_SIMILITUD=0.92


# ---- LANGFUSE (observabilidad) ----
# Cópialos de http://localhost:3000 → Settings → API Keys (tras el primer arranque).
# Si los dejas vacíos, el tracing se desactiva solo (la app sigue funcionando).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000


# ---- EVALUACIÓN (CI gate) ----
# Score mínimo (0.0-1.0) de la tríada RAG para que un deploy se apruebe.
# Si baja de aquí, ci_gate.py sale con código 1 y BLOQUEA el deploy.
EVAL_UMBRAL_APROBACION=0.7
# ¿Qué porcentaje del dataset evalúa la CI? 1.0 = todo; 0.2 = una quinta parte (más rápido).
EVAL_MUESTRA=0.2


# ---- API (FastAPI) ----
# Puerto en el que sirve la app.
APP_PORT=8000
# Nivel del rol por defecto cuando no se especifica uno en la request.
# Roles válidos: public, analyst, compliance (ver guardrails/rbac.py).
APP_ROL_POR_DEFECTO=analyst
